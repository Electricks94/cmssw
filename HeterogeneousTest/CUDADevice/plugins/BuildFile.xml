<iftool name="cuda-gcc-support">
  <library file="*.cc *.cu" name="HeterogeneousTestCUDADevicePlugins">
    <use name="cuda"/>
    <use name="FWCore/Framework"/>
    <use name="FWCore/ParameterSet"/>
    <use name="FWCore/ServiceRegistry"/>
    <use name="HeterogeneousCore/CUDAServices"/>
    <use name="HeterogeneousCore/CUDAUtilities"/>
    <use name="HeterogeneousTest/CUDADevice"/>
    <use name="IOPool/Streamer"/>              <!-- NEW: FRDFileHeader / FRDEventMessage -->
    <flags LDFLAGS="-lcufile"/>                <!-- NEW: cuFile -->
    <flags EDM_PLUGIN="1"/>
    <flags CXXFLAGS="-lcufile"/>
  </library>
</iftool>
